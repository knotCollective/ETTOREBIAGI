---
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout title="codec ensemble" parent="audio" parentHref="#audio">
  <div class="intro">
    <p>
      Ensemble_Codec is a music group of soloists who conduct independent,
      autonomous research, using multimedia as a natural outcome.
    </p>
    <p>
      They aim to go beyond the traditional concept of a musical ensemble by
      involving every aspect of music production, from research to performance,
      and the use of technology and recording techniques.
    </p>
  </div>

  <ul class="videos">
    <li>
      <div class="caption">
        <h2 class="vtitle">Luc Ferrari — Et tournent les sons dans la garrigue</h2>
        <span class="with">ensemble Codec</span>
        <a
          class="external"
          href="https://youtu.be/qnuYGOH8Mzo"
          target="_blank"
          rel="noopener"
          aria-label="Open on YouTube"
        >
          ↗
        </a>
      </div>
      <div class="player">
        <iframe
          src="https://www.youtube-nocookie.com/embed/qnuYGOH8Mzo"
          title="Luc Ferrari — Et tournent les sons dans la garrigue"
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        />
      </div>
    </li>
  </ul>
</PageLayout>

<style>
  .intro {
    max-width: 68ch;
    margin-bottom: clamp(32px, 6vh, 64px);
  }

  .intro p {
    margin-bottom: 1em;
    color: #2b2b2b;
  }

  .videos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(28px, 5vh, 48px);
    max-width: 760px;
  }

  .caption {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 10px;
  }

  .vtitle {
    font-size: inherit;
    font-weight: 400;
    flex: 1;
  }

  .with {
    color: var(--muted);
    font-size: 11px;
    white-space: nowrap;
  }

  .external {
    color: var(--faint);
  }

  .external:hover {
    color: var(--fg);
    text-decoration: none;
  }

  .player {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    width: 100%;
  }

  .player iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 700px) {
    .with {
      display: none;
    }
  }
</style>
