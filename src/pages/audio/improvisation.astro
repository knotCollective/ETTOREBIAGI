---
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout title="improvisation" parent="audio" parentHref="#audio">
  <section class="release-group">
    <h2 class="group-title">LATEST</h2>
    <ul class="releases">
      <li>
        <a href="https://ettorebiagi.bandcamp.com/track/ex" target="_blank" rel="noopener">
          <span class="code">//ex</span>
          <span class="rule" aria-hidden="true"></span>
          <span class="desc">clarinet and live electronics</span>
          <span class="arrow">→</span>
        </a>
      </li>
      <li>
        <a href="https://ettorebiagi.bandcamp.com/album/volumen" target="_blank" rel="noopener">
          <span class="code">volumen</span>
          <span class="rule" aria-hidden="true"></span>
          <span class="desc">clarinet, objects and live electronics</span>
          <span class="arrow">→</span>
        </a>
      </li>
    </ul>
  </section>
</PageLayout>

<style>
  .group-title {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 16px;
  }

  .releases {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .releases li {
    border-top: 1px solid var(--line);
  }

  .releases li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .releases a {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 16px 0;
  }

  .releases a:hover {
    text-decoration: none;
  }

  .code {
    font-weight: 700;
    white-space: nowrap;
  }

  .rule {
    flex: 1;
    border-bottom: 1px dotted var(--faint);
    transform: translateY(-3px);
  }

  .desc {
    color: var(--muted);
    text-align: right;
  }

  .arrow {
    color: var(--faint);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .releases a:hover .arrow {
    color: var(--fg);
    transform: translateX(3px);
  }

  .releases a:hover .code {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 700px) {
    .releases a {
      flex-wrap: wrap;
    }

    .rule {
      display: none;
    }

    .desc {
      flex-basis: 100%;
      text-align: left;
    }
  }
</style>
