---
import PageLayout from '../../layouts/PageLayout.astro';
import { url } from '../../utils/url';

const video = {
  src: 'videos/sonic-machines-demo.mp4',
  poster: 'videos/sonic-machines-demo-poster.jpg',
  title: 'Sonic Machines, demo',
  note: 'kilele application — rendering',
};

const stills = [
  'images/sonic-machines-01.jpg',
  'images/sonic-machines-02.jpg',
  'images/sonic-machines-03.jpg',
  'images/sonic-machines-04.jpg',
  'images/sonic-machines-05.jpg',
  'images/sonic-machines-06.jpg',
];

const thousandVideos = [
  {
    src: 'videos/thousand-questions-recording.mp4',
    poster: 'videos/thousand-questions-recording-poster.jpg',
    title: 'A thousand questions hit my eyes from the inside — recording',
    note: '7:09',
  },
  {
    src: 'videos/thousand-questions-demo-2.mp4',
    poster: 'videos/thousand-questions-demo-2-poster.jpg',
    title: 'demo 2',
    note: '4:19',
  },
  {
    src: 'videos/thousand-questions-demo-3.mp4',
    poster: 'videos/thousand-questions-demo-3-poster.jpg',
    title: 'demo 3',
    note: '0:27',
  },
  {
    src: 'videos/thousand-questions-demo-4.mp4',
    poster: 'videos/thousand-questions-demo-4-poster.jpg',
    title: 'demo 4',
    note: '0:52',
  },
  {
    src: 'videos/thousand-questions-demo-5.mp4',
    poster: 'videos/thousand-questions-demo-5-poster.jpg',
    title: 'demo 5',
    note: '1:15',
    wide: true,
  },
  {
    src: 'videos/thousand-questions-demo-6.mp4',
    poster: 'videos/thousand-questions-demo-6-poster.jpg',
    title: 'demo 6',
    note: '1:03',
    wide: true,
  },
  {
    src: 'videos/thousand-questions-demo-7.mp4',
    poster: 'videos/thousand-questions-demo-7-poster.jpg',
    title: 'demo 7',
    note: '1:29',
    wide: true,
  },
];

const thousandStills = [
  'images/thousand-questions-01.jpg',
  'images/thousand-questions-02.jpg',
  'images/thousand-questions-03.jpg',
  'images/thousand-questions-04.jpg',
  'images/thousand-questions-05.jpg',
];
---

<PageLayout title="3d animation" parent="visual" parentHref="#visual" wide>
  <section class="project project--aq">
    <h2 class="project-title">
      A thousand questions hit my eyes from the inside
    </h2>
    <p class="project-desc">
      "A thousand questions hit my eyes from the inside" is an audiovisual
      project that combines electroacoustic improvisation and digital processing
      of live paintings. Through a bridging between OpenFrameworks and
      Supercollider I created sound-driven live processing of painting gestures,
      signs and drawings through the eyes of a webcam that looks at its on
      renderings in real time.
    </p>

    <div class="project-media">
      {
        thousandVideos.map((vid) => (
          <div class:list={['video', 'project-video', vid.wide && 'project-video--169']}>
            <div class="caption">
              <h3 class="vtitle">{vid.title}</h3>
              <span class="note">{vid.note}</span>
            </div>
            <video
              class="player"
              controls
              playsinline
              preload="metadata"
              poster={url(vid.poster)}
            >
              <source src={url(vid.src)} type="video/mp4" />
            </video>
          </div>
        ))
      }
    </div>

    <section class="stills project-stills">
      <h3 class="stills-title">stills</h3>
      <ul>
        {
          thousandStills.map((still, i) => (
            <li>
              <a href={url(still)} target="_blank" rel="noopener">
                <img
                  src={url(still)}
                  alt={`A thousand questions hit my eyes from the inside still ${i + 1}`}
                  loading="lazy"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </section>

  <section class="project">
    <h2 class="project-title">Sonic Machines</h2>
    <p class="project-desc">
      badpure collaborates with composers and performers to realize sound-driven
      audiovisual works. Sonic Machines is part of an ongoing collaboration with
      Alessandro Baticci (alias DUSKND) and it encompasses 3d animation, Machine
      Learning and audiovisual improvisation.
    </p>

    <div class="project-media">
      <div class="video project-video">
        <div class="caption">
          <h3 class="vtitle">{video.title}</h3>
          <span class="note">{video.note}</span>
        </div>
        <video
          class="player"
          controls
          playsinline
          preload="metadata"
          poster={url(video.poster)}
        >
          <source src={url(video.src)} type="video/mp4" />
        </video>
      </div>
    </div>

    <section class="stills project-stills">
      <h3 class="stills-title">renders</h3>
      <ul>
        {
          stills.map((still, i) => (
            <li>
              <a href={url(still)} target="_blank" rel="noopener">
                <img
                  src={url(still)}
                  alt={`Sonic Machines render ${i + 1}`}
                  loading="lazy"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </section>
</PageLayout>

<style>
  .project {
    max-width: 760px;
    margin-bottom: clamp(40px, 7vh, 72px);
  }

  .project-title {
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.02em;
    margin-bottom: 14px;
  }

  .project-desc {
    color: #2b2b2b;
    font-size: 12px;
    line-height: 1.7;
    max-width: 62ch;
  }

  .project-media {
    margin-top: clamp(24px, 4vh, 40px);
  }

  .project-video + .project-video {
    margin-top: clamp(24px, 4vh, 40px);
  }

  .project--aq .project-video .player {
    aspect-ratio: 3456 / 2162;
  }

  .project--aq .project-video--169 .player {
    aspect-ratio: 16 / 9;
  }

  .video {
    max-width: 760px;
  }

  .caption {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 10px;
  }

  .vtitle {
    font-size: inherit;
    font-weight: 400;
    flex: 1;
  }

  .note {
    color: var(--muted);
    font-size: 11px;
    white-space: nowrap;
  }

  .player {
    display: block;
    width: 100%;
    aspect-ratio: 1280 / 540;
    background: #000;
    object-fit: contain;
  }

  .stills {
    margin-top: clamp(40px, 7vh, 72px);
    max-width: 760px;
  }

  .stills-title {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .stills ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .stills img {
    display: block;
    width: 100%;
    height: auto;
    background: #000;
  }

  .stills a {
    display: block;
    overflow: hidden;
  }

  .stills a img {
    transition: transform 0.5s ease;
  }

  .stills a:hover img {
    transform: scale(1.03);
  }

  @media (max-width: 700px) {
    .note {
      display: none;
    }

    .stills ul {
      grid-template-columns: 1fr;
    }
  }
</style>
