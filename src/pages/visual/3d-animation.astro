---
import PageLayout from '../../layouts/PageLayout.astro';
import { url } from '../../utils/url';

const video = {
  src: 'videos/sonic-machines-demo.mp4',
  poster: 'videos/sonic-machines-demo-poster.jpg',
  title: 'Sonic Machines, demo',
  note: 'kilele application — rendering',
};

const stills = [
  'images/sonic-machines-01.jpg',
  'images/sonic-machines-02.jpg',
  'images/sonic-machines-03.jpg',
  'images/sonic-machines-04.jpg',
  'images/sonic-machines-05.jpg',
  'images/sonic-machines-06.jpg',
];
---

<PageLayout title="3d animation" parent="visual" parentHref="#visual">
  <section class="project">
    <h2 class="project-title">
      A thousand questions hit my eyes from the inside
    </h2>
    <p class="project-desc">
      "A thousand questions hit my eyes from the inside" is an audiovisual
      project that combines electroacoustic improvisation and digital processing
      of live paintings. Through a bridging between OpenFrameworks and
      Supercollider I created sound-driven live processing of painting gestures,
      signs and drawings through the eyes of a webcam that looks at its on
      renderings in real time.
    </p>
  </section>

  <div class="video">
    <div class="caption">
      <h2 class="vtitle">{video.title}</h2>
      <span class="note">{video.note}</span>
    </div>
    <video
      class="player"
      controls
      playsinline
      preload="metadata"
      poster={url(video.poster)}
    >
      <source src={url(video.src)} type="video/mp4" />
    </video>
  </div>

  <section class="stills">
    <h3 class="stills-title">renders</h3>
    <ul>
      {
        stills.map((still, i) => (
          <li>
            <a href={url(still)} target="_blank" rel="noopener">
              <img
                src={url(still)}
                alt={`Sonic Machines render ${i + 1}`}
                loading="lazy"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <p slot="aside">
    badpure collaborates with composers and performers to realize sound-driven
    audiovisual works. Sonic Machines is part of an ongoing collaboration with
    Alessandro Baticci (alias DUSKND) and it encompasses 3d animation, Machine
    Learning and audiovisual improvisation.
  </p>
</PageLayout>

<style>
  .project {
    max-width: 760px;
    margin-bottom: clamp(40px, 7vh, 72px);
  }

  .project-title {
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.02em;
    margin-bottom: 14px;
  }

  .project-desc {
    color: #2b2b2b;
    font-size: 12px;
    line-height: 1.7;
    max-width: 62ch;
  }

  .video {
    max-width: 760px;
  }

  .caption {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 10px;
  }

  .vtitle {
    font-size: inherit;
    font-weight: 400;
    flex: 1;
  }

  .note {
    color: var(--muted);
    font-size: 11px;
    white-space: nowrap;
  }

  .player {
    display: block;
    width: 100%;
    aspect-ratio: 1280 / 540;
    background: #000;
    object-fit: contain;
  }

  .stills {
    margin-top: clamp(40px, 7vh, 72px);
    max-width: 760px;
  }

  .stills-title {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .stills ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .stills img {
    display: block;
    width: 100%;
    height: auto;
    background: #000;
  }

  .stills a {
    display: block;
    overflow: hidden;
  }

  .stills a img {
    transition: transform 0.5s ease;
  }

  .stills a:hover img {
    transform: scale(1.03);
  }

  @media (max-width: 700px) {
    .note {
      display: none;
    }

    .stills ul {
      grid-template-columns: 1fr;
    }
  }
</style>
