---
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
import { base } from '../utils/url';

interface Props {
  title: string;
  parent: string;
  parentHref: string;
}

const { title, parent, parentHref } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<Base title={`${title} — Ettore Biagi`}>
  <main class="page">
    <div class="pane sidebar-pane">
      <Sidebar />
    </div>
    <div class="pane content-pane">
      <div class:list={['content', hasAside && 'content-wide']}>
        <nav class="breadcrumb">
          <a href={`${base}${parentHref}`}>← {parent}</a>
          <span class="sep">/</span>
          <span class="current">{title}</span>
        </nav>
        <h1 class="title">{title}</h1>
        {
          hasAside ? (
            <div class="body has-aside">
              <div class="main">
                <slot />
              </div>
              <aside class="aside">
                <slot name="aside" />
              </aside>
            </div>
          ) : (
            <slot />
          )
        }
      </div>
    </div>
  </main>
</Base>

<style>
  .page {
    display: grid;
    grid-template-columns: minmax(300px, 1.15fr) 3fr;
    height: 100vh;
    overflow: hidden;
  }

  .pane {
    min-height: 0;
    height: 100%;
  }

  .sidebar-pane {
    border-right: 1px solid var(--line);
  }

  .content-pane {
    overflow-y: auto;
  }

  .content {
    padding: var(--pad);
    max-width: 74ch;
  }

  .content-wide {
    max-width: 1180px;
  }

  .body.has-aside {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(200px, 300px);
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
  }

  .aside {
    position: sticky;
    top: var(--pad);
    font-size: 12px;
    line-height: 1.7;
    color: #2b2b2b;
  }

  .breadcrumb {
    color: var(--muted);
    font-size: 11px;
    display: flex;
    gap: 8px;
    margin-bottom: clamp(28px, 6vh, 72px);
  }

  .breadcrumb .sep {
    color: var(--faint);
  }

  .breadcrumb .current {
    color: var(--fg);
  }

  .title {
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.02em;
    margin-bottom: 26px;
  }

  @media (max-width: 900px) {
    .page {
      grid-template-columns: 1fr;
      height: auto;
      overflow: visible;
    }

    .pane {
      height: auto;
    }

    .content-pane {
      overflow: visible;
      border-top: 1px solid var(--line);
    }

    .body.has-aside {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .aside {
      position: static;
      max-width: 60ch;
    }
  }
</style>
