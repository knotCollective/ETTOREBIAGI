---
import { bio } from '../data/site';
import { base } from '../utils/url';
---

<aside class="sidebar">
  <header class="identity">
    <a class="name" href={base}>
      <span class="name-bold">Ettore Biagi</span>
      <span class="alias">bad pure</span>
    </a>
  </header>

  <section class="about">
    <h2 class="about-title">about_</h2>
    <div class="about-body">
      {bio.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>
</aside>

<style>
  .sidebar {
    padding: var(--pad);
    overflow-y: auto;
    height: 100%;
  }

  .identity {
    margin-bottom: clamp(28px, 5vh, 64px);
  }

  .name {
    display: block;
  }

  .name-bold {
    display: block;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.02em;
  }

  .alias {
    display: block;
    color: var(--muted);
    margin-top: 2px;
  }

  .about-title {
    font-size: inherit;
    font-weight: 400;
    margin-bottom: 14px;
  }

  .about-body {
    max-width: 46ch;
  }

  .about-body p {
    margin-bottom: 1em;
    color: #2b2b2b;
    font-size: 12px;
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .sidebar {
      height: auto;
      overflow: visible;
    }
  }
</style>
