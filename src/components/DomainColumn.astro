---
import type { Domain } from '../data/site';
import { url } from '../utils/url';

interface Props {
  domain: Domain;
}

const { domain } = Astro.props;
const gallery = domain.hoverImages?.map((image) => url(image)) ?? null;
---

<section
  class:list={['column', gallery && 'has-gallery']}
  id={domain.id}
  aria-label={domain.label}
  data-tone="light"
>
  {
    gallery && (
      <div class="gallery" data-gallery data-images={JSON.stringify(gallery)}>
        <img src={gallery[0]} alt="" />
        <img alt="" />
      </div>
    )
  }

  <div class="column-inner">
    <header class="head">
      <h2 class="label">{domain.label}</h2>
      <p class="kicker">{domain.kicker}</p>
    </header>

    <div class="reveal" aria-hidden="true"></div>

    <nav class="links">
      <ul>
        {
          domain.links.map((link) => (
            <li>
              <a href={url(link.href)}>
                <span class="mark">↳</span>
                <span class="text">{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</section>

<script>
  function initGallery() {
    const column = document.querySelector<HTMLElement>('.column.has-gallery');
    if (!column) return;
    const gallery = column.querySelector<HTMLElement>('[data-gallery]');
    if (!gallery) return;

    let images: string[] = [];
    try {
      images = JSON.parse(gallery.dataset.images || '[]');
    } catch {
      return;
    }
    if (images.length < 2) return;

    const layers = Array.from(gallery.querySelectorAll<HTMLImageElement>('img'));
    let active = 0;
    let current = -1;
    let hovering = false;

    const tone = (image: HTMLImageElement) => {
      try {
        const canvas = document.createElement('canvas');
        canvas.width = 32;
        canvas.height = 32;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        ctx.drawImage(image, 0, 0, 32, 32);
        const { data } = ctx.getImageData(0, 0, 32, 32);
        let sum = 0;
        for (let i = 0; i < data.length; i += 4) {
          sum += 0.2126 * data[i] + 0.7152 * data[i + 1] + 0.0722 * data[i + 2];
        }
        const luminance = sum / (data.length / 4) / 255;
        column.dataset.tone = luminance < 0.45 ? 'dark' : 'light';
      } catch {
        /* cross-origin or canvas issues — keep current tone */
      }
    };

    const reveal = (index: number) => {
      const layer = layers[active];
      layer.onload = () => {
        if (!hovering) return;
        layers.forEach((item) => item.classList.remove('is-active'));
        layer.classList.add('is-active');
        tone(layer);
      };
      layer.src = images[index];
      current = index;
      active = (active + 1) % layers.length;
    };

    const hide = () => {
      layers.forEach((item) => item.classList.remove('is-active'));
      column.dataset.tone = 'light';
    };

    images.forEach((src) => {
      const preloader = new Image();
      preloader.src = src;
    });

    let busy = false;
    column.addEventListener('mouseenter', () => {
      hovering = true;
      if (busy) return;
      busy = true;
      let next = current;
      while (next === current) next = Math.floor(Math.random() * images.length);
      reveal(next);
      window.setTimeout(() => {
        busy = false;
      }, 350);
    });

    column.addEventListener('mouseleave', () => {
      hovering = false;
      hide();
    });
  }

  if (document.readyState !== 'loading') initGallery();
  else document.addEventListener('DOMContentLoaded', initGallery);
</script>

<style>
  .column {
    height: 100%;
    overflow-y: auto;
    border-left: 1px solid var(--line);
    scrollbar-width: thin;
  }

  .column-inner {
    padding: var(--pad);
    min-height: 100%;
    display: flex;
    flex-direction: column;
  }

  .head {
    position: sticky;
    top: 0;
    background: var(--bg);
    padding-bottom: 12px;
    z-index: 2;
  }

  .label {
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .kicker {
    color: var(--faint);
    font-size: 11px;
    margin-top: 4px;
  }

  .reveal {
    height: 46vh;
    flex: none;
  }

  .links ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links li {
    border-top: 1px solid var(--line);
  }

  .links li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .links a {
    display: flex;
    gap: 10px;
    padding: 12px 0;
    align-items: baseline;
  }

  .links a:hover {
    text-decoration: none;
  }

  .mark {
    color: var(--faint);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .links a:hover .mark {
    color: var(--fg);
    transform: translateX(3px);
  }

  .links a:hover .text {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .column.has-gallery {
    position: relative;
  }

  .gallery {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: var(--bg);
  }

  .gallery img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .gallery img.is-active {
    opacity: 1;
  }

  .column.has-gallery .column-inner {
    position: relative;
    z-index: 1;
  }

  .column.has-gallery .head {
    background: transparent;
  }

  .column.has-gallery .label,
  .column.has-gallery .kicker,
  .column.has-gallery .links .text,
  .column.has-gallery .links .mark {
    text-shadow: 0 1px 3px rgba(255, 255, 255, 0.7);
  }

  .column.has-gallery[data-tone='light'] .links li {
    border-color: rgba(0, 0, 0, 0.18);
  }

  .column.has-gallery[data-tone='dark'] .label,
  .column.has-gallery[data-tone='dark'] .kicker,
  .column.has-gallery[data-tone='dark'] .links .text,
  .column.has-gallery[data-tone='dark'] .links .mark {
    color: #fff;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
  }

  .column.has-gallery[data-tone='dark'] .links li {
    border-color: rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 900px) {
    .column {
      height: auto;
      overflow: visible;
      border-left: none;
      border-top: 1px solid var(--line);
    }

    .reveal {
      height: 8vh;
    }

    .column.has-gallery {
      display: flex;
      flex-direction: column;
    }

    .gallery {
      position: relative;
      inset: auto;
      order: -1;
      height: 42vh;
    }

    .gallery img {
      position: absolute;
    }

    .column.has-gallery .label,
    .column.has-gallery .kicker,
    .column.has-gallery .links .text,
    .column.has-gallery .links .mark,
    .column.has-gallery[data-tone='dark'] .label,
    .column.has-gallery[data-tone='dark'] .kicker,
    .column.has-gallery[data-tone='dark'] .links .text,
    .column.has-gallery[data-tone='dark'] .links .mark {
      color: inherit;
      text-shadow: none;
    }

    .column.has-gallery[data-tone='dark'] .links li {
      border-color: var(--line);
    }
  }
</style>
